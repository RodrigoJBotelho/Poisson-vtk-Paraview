#!/usr/bin/env python3
"""Testes automaticos: compilacao ja feita; aqui roda o solver e valida os resultados."""
import os
import subprocess
import sys
import tempfile

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "scripts"))
from posprocessar import ler_vti  # noqa: E402

EXE = "./poisson"


def rodar(dim, n, caso="seno"):
    tmp = tempfile.mkdtemp()
    subprocess.run([EXE, "--dim", str(dim), "--n", str(n), "--caso", caso, "--saida", tmp,
                    "--tol", "1e-10"], check=True, stdout=subprocess.DEVNULL)  # exit != 0 => nao convergiu
    resumo = dict(l.strip().split("=") for l in open(os.path.join(tmp, "resumo.txt")))
    return tmp, resumo


def teste_convergencia_ordem2():
    erros = []
    for n in (17, 33, 65):
        _, r = rodar(2, n)
        erros.append(float(r["erro_L2"]))
    for a, b in zip(erros, erros[1:]):
        ordem = (a / b) / 1.0
        assert 3.5 < ordem < 4.5, "razao de erro %.2f fora do esperado (~4 => ordem 2)" % ordem


def teste_vti_valido():
    tmp, _ = rodar(3, 17)
    campos, dims, esp = ler_vti(os.path.join(tmp, "solucao.vti"))
    assert dims == (17, 17, 17), dims
    assert abs(esp[0] - 1 / 16) < 1e-12
    for nome in ("u_numerico", "f", "u_exato", "erro", "grad_u"):
        assert nome in campos, "campo ausente: " + nome
    assert campos["grad_u"].shape == (17, 17, 17, 3)
    assert campos["u_numerico"].max() > 0.99


def teste_vtk_legacy_valido():
    tmp, _ = rodar(2, 17)
    linhas = open(os.path.join(tmp, "solucao.vtk")).read().splitlines()
    assert linhas[0].startswith("# vtk DataFile Version")
    assert "DATASET STRUCTURED_POINTS" in linhas
    assert "DIMENSIONS 17 17 1" in linhas
    assert any(l.startswith("VECTORS grad_u") for l in linhas)


def teste_caso_gauss_sem_exata():
    tmp, r = rodar(2, 33, "gauss")
    campos, _, _ = ler_vti(os.path.join(tmp, "solucao.vti"))
    assert "erro" not in campos and "u_numerico" in campos


if __name__ == "__main__":
    falhas = 0
    for nome, fn in sorted(globals().items()):
        if nome.startswith("teste_"):
            try:
                fn()
                print("OK    ", nome)
            except Exception as e:  # noqa: BLE001
                falhas += 1
                print("FALHOU", nome, "->", e)
    sys.exit(1 if falhas else 0)

